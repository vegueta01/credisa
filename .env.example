# Copia este archivo a ".env" (ese sí NO se sube a git) y pon valores propios.
# Son las contraseñas/tokens que protegen el panel (/panel-XXXXXXXXXX/).
# Genera cada uno con:  openssl rand -hex 24

# Token de administrador: ve y edita todo (inventario, precios, créditos, cierres, agregar).
ADMIN_TOKEN=cambia-esto-por-un-token-largo-y-aleatorio

# Token de vendedor: entra al mismo panel pero solo ve el inventario (sin precio
# de compra) y el botón "Vender" — nada de precios/stock editable, créditos,
# cierre ni agregar/archivar productos. Déjalo vacío para desactivar ese acceso.
SELLER_TOKEN=cambia-esto-por-otro-token-largo-y-aleatorio
